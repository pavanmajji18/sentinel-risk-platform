aws_region        = "us-east-1"
gpu_instance_type = "p3.2xlarge"
ami_id            = ""           # leave blank to use Ubuntu 22.04 LTS fallback
vpc_cidr          = "10.0.0.0/16"
subnet_cidr       = "10.0.1.0/24"
key_pair_name     = ""           # optional: set to your EC2 key pair name for SSH
environment       = "dev"

# Restrict inbound network access
allowed_ssh_cidr_blocks = ["YOUR_IP/32"]
allowed_api_cidr_blocks = ["YOUR_IP/32"]

