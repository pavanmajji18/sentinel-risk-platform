# ==============================================================================
# SENTINEL Risk Platform — Environment Configuration Template
# Copy this file to .env and populate with appropriate values.
# NEVER commit the active .env file to version control.
# ==============================================================================

# API Security & Authentication
SENTINEL_API_KEY=your_secure_api_key_here

# Machine Learning Model Paths & Tracking
SENTINEL_MODEL_PATH=04-model-training/model/sentinel_xgb.json
MLFLOW_TRACKING_URI=http://localhost:5000

# AWS Cloud Credentials & Region
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# Terraform Remote State Storage
TF_BACKEND_BUCKET=your-terraform-state-bucket
TF_BACKEND_KEY=sentinel/production/terraform.tfstate
