{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SentinelCorpusBucketAccess",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::sentinel-corpus-*"
      ]
    },
    {
      "Sid": "SentinelCorpusObjectAccess",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::sentinel-corpus-*/*"
      ]
    },
    {
      "Sid": "SentinelEC2Describe",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeInstanceTypes",
        "ec2:DescribeInstances"
      ],
      "Resource": [
        "*"
      ]
    }
  ]
}
