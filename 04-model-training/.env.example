# ==============================================================================
# Module 04: Model Training — Environment Configuration Template
# ==============================================================================

# API & Model Configuration
SENTINEL_API_KEY=your_secure_api_key_here
SENTINEL_MODEL_PATH=model/sentinel_xgb.json
MLFLOW_TRACKING_URI=http://localhost:5000

# AWS Cloud Credentials & Region (for dataset sync / model registry)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# Remote Storage
TF_BACKEND_BUCKET=your-terraform-state-bucket
TF_BACKEND_KEY=sentinel/training/terraform.tfstate
